# Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── SERVER ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── DATABASE ─────────────────────────────────────────────────
# Get your connection string from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/gautam-portfolio?retryWrites=true&w=majority

# ── AUTHENTICATION ────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=your_super_secret_jwt_key_here_replace_this
JWT_EXPIRES_IN=7d

# ── ADMIN CREDENTIALS ─────────────────────────────────────────
# These are used to seed the admin user on first run
ADMIN_EMAIL=admin@gautam.dev
ADMIN_PASSWORD=your_secure_admin_password_here

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── CLOUDINARY (optional for images) ─────────────────────────
# Get from https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── UPLOAD ────────────────────────────────────────────────────
# Max file size in bytes (5MB default)
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# ── NVIDIA NEMOTRON AI CHATBOT ────────────────────────────────
# Get API key from https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
